# Frontend
NEXT_PUBLIC_SAFU_API=/api
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_SAFU_CONTRACT=cover.safufun-d73f3d.testnet

# Backend (src/server). Private keys are optional locally: they fall back to
# ~/.near-credentials/<network>/<account>.json. On a server, set them here.
NEAR_NETWORK=testnet
SAFU_CONTRACT=cover.safufun-d73f3d.testnet
API_ACCOUNT=api.safufun-d73f3d.testnet
API_PRIVATE_KEY=
API_QUOTE_SIGNING_KEY=
API_QUOTE_PUBLIC_KEY=
QUOTE_TTL_MS=300000
COVER_DAYS=7
NEARBLOCKS_API_KEY=
BLOCKSCOUT_API_KEY=
TREASURY_ACCOUNT=
ONECLICK_JWT=
WATCHER_ACCOUNT=watcher.safufun-d73f3d.testnet
WATCHER_PRIVATE_KEY=
R1_THRESHOLD_BPS=5000
R2_THRESHOLD_BPS=5000
POLL_MS=15000
HEARTBEAT_MS=300000
RELAYER_ACCOUNT=relayer.safufun-d73f3d.testnet
RELAYER_PRIVATE_KEY=
RAIL_A_ENABLED=false
RAIL_PREFERENCE=A
SLIPPAGE_BPS=100

# Background jobs: in-process by default (src/instrumentation.ts).
# On serverless hosts set SAFU_JOBS=off and call GET /api/cron/{watcher,relayer,buys}
# with "Authorization: Bearer $CRON_SECRET".
SAFU_JOBS=on
CRON_SECRET=
